{
  "name": "sfhousing",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "routes": [{ "pattern": "sfhousing.mindlace.net", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "enabled": true } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfhousing",
      // created 2026-10-10, region WNAM
      "database_id": "08b75fb1-bf24-4d3d-88b2-f236a6be5f77",
      "preview_database_id": "local",
      "migrations_dir": "./migrations/d1"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sfhousing" }],
  "ratelimits": [
    // namespace_id is a user-chosen integer, unique within the Cloudflare account
    { "name": "PUBLISH_RL", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // bumped by the data-pipeline upload PR (spec §4.3)
    "PUBLIC_DATASET_VERSION": "2026-10-16-685e203c",
    "PUBLIC_APP_RELEASE": "dev"
  },
  "env": {
    "staging": {
      "name": "sfhousing-staging",
      "compatibility_date": "2026-03-01",
      "compatibility_flags": ["nodejs_compat"],
      "main": ".svelte-kit/cloudflare/_worker.js",
      "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
      "routes": [{ "pattern": "sfhousing-staging.mindlace.net", "custom_domain": true }],
      "observability": { "enabled": true, "logs": { "enabled": true } },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sfhousing-staging",
          // created 2026-10-10, region WNAM
          "database_id": "7975fab5-91fd-4947-8e88-af64bdc6e251",
          "preview_database_id": "local",
          "migrations_dir": "./migrations/d1"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "sfhousing" }],
      "ratelimits": [
        // namespace_id is a user-chosen integer, unique within the Cloudflare account
        { "name": "PUBLISH_RL", "namespace_id": "4201", "simple": { "limit": 10, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        // bumped by the data-pipeline upload PR (spec §4.3)
        "PUBLIC_DATASET_VERSION": "2026-10-19-e54d20ca",
        "PUBLIC_APP_RELEASE": "dev"
      }
    }
  }
}
